<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization" output-token-variable-name="jwt" require-scheme="Bearer" require-expiration-time="true"
                  require-signed-tokens="true" failed-validation-httpcode="401">
      <openid-config url="{{entra-openid-configuration-url}}" />
      <audiences>
        <audience>{{consolidado-api-audience}}</audience>
      </audiences>
      <issuers>
        <issuer>{{entra-issuer}}</issuer>
      </issuers>
    </validate-jwt>
    <rate-limit-by-key calls="120" renewal-period="60"
      counter-key="@(((Jwt)context.Variables[&quot;jwt&quot;]).Claims.ContainsKey(&quot;oid&quot;) ? ((Jwt)context.Variables[&quot;jwt&quot;]).Claims[&quot;oid&quot;][0] : ((Jwt)context.Variables[&quot;jwt&quot;]).Claims[&quot;sub&quot;][0])"
      remaining-calls-header-name="X-RateLimit-Remaining"
      total-calls-header-name="X-RateLimit-Limit" />
    <choose>
      <when condition="@(context.Request.Method == &quot;GET&quot;)">
        <choose>
          <when condition="@(((Jwt)context.Variables[&quot;jwt&quot;]).Claims.ContainsKey(&quot;scp&quot;) &amp;&amp; ((Jwt)context.Variables[&quot;jwt&quot;]).Claims[&quot;scp&quot;][0].Split(' ').Contains(&quot;consolidado.read&quot;))" />
          <otherwise>
            <return-response>
              <set-status code="403" reason="Forbidden" />
            </return-response>
          </otherwise>
        </choose>
      </when>
      <otherwise>
        <return-response>
          <set-status code="405" reason="Method Not Allowed" />
        </return-response>
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
