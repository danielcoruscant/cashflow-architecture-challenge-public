    "jsdom": "^31.0.1",
    "openapi-typescript-codegen": "^0.31.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "openapi --input ../contracts/lancamentos-api/openapi.yaml --output src/generated/lancamentos --client fetch && openapi --input ../contracts/consolidado-api/openapi.yaml --output src/generated/consolidado --client fetch",
