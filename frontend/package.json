  "dependencies": {
    "@azure/msal-browser": "^5.30.0",
    "@azure/msal-react": "^5.8.3",
    "@hookform/resolvers": "^7.0.7",
    "@tanstack/react-query": "^5.108.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
