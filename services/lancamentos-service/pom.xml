<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.com.cashflow</groupId>
    <artifactId>lancamentos-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>lancamentos-service</name>
    <description>Serviço de registro e consulta de lançamentos financeiros do fluxo de caixa.</description>

    <properties>
        <java.version>25</java.version>
        <openapi-generator.version>7.12.0</openapi-generator.version>
        <springdoc.version>2.8.6</springdoc.version>
        <azure-cosmos.version>4.61.0</azure-cosmos.version>
        <azure-identity.version>1.15.4</azure-identity.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <netty.version>4.1.141.Final</netty.version>
        <tomcat.version>10.1.62</tomcat.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <jacoco.version>0.8.16</jacoco.version>
        <applicationinsights-agent.version>3.7.9</applicationinsights-agent.version>
        <contract.package.request>br.com.cashflow.lancamentos.interfaces.request</contract.package.request>
        <contract.package.response>br.com.cashflow.lancamentos.interfaces.response</contract.package.response>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>0.2.6</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-cosmos</artifactId>
            <version>${azure-cosmos.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>${azure-identity.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>${project.basedir}/tests/unit</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <configuration>
                    <inputSpec>${project.basedir}/../../contracts/lancamentos-api/openapi.yaml</inputSpec>
                    <generatorName>spring</generatorName>
                    <generateSupportingFiles>false</generateSupportingFiles>
                    <configOptions>
                        <interfaceOnly>true</interfaceOnly>
                        <useSpringBoot3>true</useSpringBoot3>
                        <useTags>true</useTags>
                        <skipDefaultInterface>true</skipDefaultInterface>
                        <requestMappingMode>api_interface</requestMappingMode>
                        <useResponseEntity>true</useResponseEntity>
                        <dateLibrary>java8</dateLibrary>
                        <annotationLibrary>swagger2</annotationLibrary>
                        <documentationProvider>springdoc</documentationProvider>
                    </configOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-lancamentos-api-and-responses</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <apiPackage>br.com.cashflow.lancamentos.interfaces.api.generated</apiPackage>
                            <modelPackage>${contract.package.response}</modelPackage>
                            <modelsToGenerate>LancamentoResponse,ErroResponse,TipoLancamento,PaginaLancamentosResponse</modelsToGenerate>
                            <importMappings>
                                <importMapping>CriarLancamentoRequest=${contract.package.request}.CriarLancamentoRequest</importMapping>
                            </importMappings>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-lancamentos-requests</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generateApis>false</generateApis>
                            <modelPackage>${contract.package.request}</modelPackage>
                            <modelsToGenerate>CriarLancamentoRequest</modelsToGenerate>
                            <importMappings>
                                <importMapping>TipoLancamento=${contract.package.response}.TipoLancamento</importMapping>
                            </importMappings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-application-insights-agent</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.microsoft.azure</groupId>
                                    <artifactId>applicationinsights-agent</artifactId>
                                    <version>${applicationinsights-agent.version}</version>
                                    <destFileName>applicationinsights-agent.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-integration-and-contract-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/tests/integration</source>
                                <source>${project.basedir}/tests/contract</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
